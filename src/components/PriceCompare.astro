---
import Icon from './Icon.astro';
interface Price { name: string; price: string; badge: string; desc: string; href?: string; }
const { items = [], note = '' } = Astro.props as { items: Price[]; note?: string };
---
<!-- Ref: daftar harga editorial bernomor (tabel runtuh jadi kartu <768px), tanpa pola 3 kartu sama besar -->
<div class="rule border-t border-steel/25">
  <div class="hidden grid-cols-12 gap-4 px-1 py-3 md:grid" aria-hidden="true">
    <span class="label col-span-1 text-steel">No</span>
    <span class="label col-span-5 text-steel">Paket</span>
    <span class="label col-span-2 text-steel">Harga</span>
    <span class="label col-span-3 text-steel">Catatan</span>
    <span class="label col-span-1 text-right text-steel">Aksi</span>
  </div>
  {items.map((p, i) => {
    const claim = /klaim/i.test(p.badge);
    return (
      <article class="rule grid grid-cols-1 gap-3 border-t border-steel/25 py-6 md:grid-cols-12 md:items-baseline md:gap-4">
        <p class="num flex items-center gap-3 text-xs text-steel md:col-span-1">
          <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          {claim && <span class="label border border-marker/60 px-2 py-0.5 text-marker">Klaim</span>}
        </p>
        <div class="md:col-span-5">
          <h3 class="font-display text-lg font-bold uppercase leading-tight tracking-tight">{p.name}</h3>
          <p class="num mt-1 text-[11px] uppercase tracking-[0.14em] text-steel md:hidden">{p.badge}</p>
        </div>
        <p class:list={["num text-2xl font-medium md:col-span-2", claim ? "text-marker" : "text-paper"]}>{p.price}</p>
        <p class="text-sm leading-relaxed text-steel md:col-span-3">{p.desc.trim()}</p>
        <div class="md:col-span-1 md:text-right">
          {p.href
            ? <a href={p.href} class="inline-flex min-h-[44px] items-center gap-2 border border-steel/40 px-4 font-mono text-[11px] uppercase tracking-[0.14em] text-paper transition-colors hover:border-marker hover:text-marker active:scale-[0.98] md:px-3">Pilih <Icon name="arrow" size={14} /></a>
            : <span class="num text-[11px] uppercase tracking-[0.14em] text-steel">&mdash;</span>}
        </div>
      </article>
    );
  })}
</div>
{note && <p class="mt-5 max-w-[80ch] text-xs leading-relaxed text-steel">{note}</p>}
