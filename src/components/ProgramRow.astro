---
import Icon from './Icon.astro';
interface Props {
  index: string;
  name: string;
  desc: string;
  badge: string;
  img: string;
  alt: string;
  meta?: string[];
  href: string;
  ctaLabel?: string;
  flip?: boolean;
}
const { index, name, desc, badge, img, alt, meta = [], href, ctaLabel = 'Jadwalkan trial', flip = false } = Astro.props;
const verified = /terverifikasi/i.test(badge);
---
<!-- Ref: daftar program editorial — indeks bernomor 01..., border-t, judul + deskripsi + baris meta mono -->
<article class="rule grid grid-cols-1 gap-x-8 gap-y-6 border-t border-steel/25 py-8 md:grid-cols-12 md:items-start">
  <p class="num text-sm text-marker md:col-span-1" aria-hidden="true">{index}</p>
  <div class:list={["md:col-span-7", flip && "md:order-3"]}>
    <div class="flex flex-wrap items-center gap-3">
      <span class:list={["label border px-2 py-1", verified ? "border-marker/60 text-marker" : "border-steel/40 text-steel"]}>{badge}</span>
    </div>
    <h3 class="mt-3 font-display text-2xl font-bold uppercase leading-[1.02] tracking-tight md:text-3xl">{name}</h3>
    <p class="mt-3 max-w-[58ch] text-sm leading-relaxed text-steel">{desc}</p>
    {meta.length > 0 && (
      <dl class="mt-5 flex flex-wrap gap-x-8 gap-y-2">
        {meta.map((m) => {
          const [k, v] = m.split('~');
          return (
            <div class="num text-[11px] uppercase tracking-[0.14em]">
              <dt class="text-steel/80">{k}</dt>
              <dd class="text-paper">{v}</dd>
            </div>
          );
        })}
      </dl>
    )}
    <a href={href} class="mt-5 inline-flex min-h-[48px] items-center gap-2 border-b-2 border-marker pb-1 font-mono text-[11px] font-medium uppercase tracking-[0.16em] text-paper transition-colors hover:text-marker active:scale-[0.98]">
      {ctaLabel} <Icon name="arrow" size={16} />
    </a>
  </div>
  <div class:list={["md:col-span-4", flip && "md:order-2"]}>
    <img src={img} alt={alt} width="800" height="533" loading="lazy" decoding="async" class="cut-lr aspect-[4/3] w-full object-cover" />
  </div>
</article>
