---
const { action = '#', gymName = 'Gym', kind = 'wa', contact = '' } = Astro.props as { action?: string; gymName?: string; kind?: 'wa' | 'dm' | 'maps'; contact?: string };
const hint = kind === 'dm' ? 'Form ini membuka DM Instagram — tanpa login tambahan.' : kind === 'maps' ? 'Form ini menyiapkan info kunjungan + rute Google Maps.' : 'Form ini membuka WhatsApp — tanpa login tambahan.';
const fieldCls = 'mt-2 w-full min-h-[48px] border border-steel/40 bg-ink px-4 text-base text-paper placeholder:text-steel/60 focus-visible:border-marker';
---
<!-- Ref: form trial — validasi + empty state, lanjut ke WhatsApp resmi -->
<form class="trial-form rule border border-steel/30 bg-ink-deep p-6 md:p-8" data-kind={kind} data-action={action} data-contact={contact} data-gym={gymName} novalidate>
  <p class="label text-marker">Trial / konsultasi</p>
  <p class="mt-2 text-sm text-steel">{hint}</p>
  <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
      <label for="tf-nama" class="text-sm font-medium">Nama</label>
      <input id="tf-nama" name="nama" type="text" autocomplete="name" placeholder="cth. Putri" class={fieldCls} aria-describedby="tf-nama-err" />
      <p id="tf-nama-err" class="err mt-1 hidden text-sm text-marker" role="alert"></p>
    </div>
    <div>
      <label for="tf-kontak" class="text-sm font-medium">No. WA / IG aktif</label>
      <input id="tf-kontak" name="kontak" type="text" autocomplete="tel" placeholder="cth. 0812xxxx / @akun" class={fieldCls} aria-describedby="tf-kontak-err" />
      <p id="tf-kontak-err" class="err mt-1 hidden text-sm text-marker" role="alert"></p>
    </div>
  </div>
  <div class="mt-4">
    <label for="tf-tujuan" class="text-sm font-medium">Tujuan latihan</label>
    <select id="tf-tujuan" name="tujuan" class={fieldCls}>
      <option value="">— Pilih dulu —</option>
      <option>Fatloss / turun berat</option>
      <option>Naik massa otot</option>
      <option>Kelas grup / stamina</option>
      <option>Konsultasi dulu</option>
    </select>
    <p id="tf-tujuan-err" class="err mt-1 hidden text-sm text-marker" role="alert"></p>
  </div>
  <div class="mt-4">
    <label for="tf-pesan" class="text-sm font-medium">Pesan <span class="text-steel">(opsional)</span></label>
    <textarea id="tf-pesan" name="pesan" rows="3" placeholder="cth. Pemula, mau coba sesi sore…" class={fieldCls + ' py-3'}></textarea>
  </div>
  <p class="form-empty mt-4 hidden border border-marker/50 px-4 py-3 text-sm text-marker" role="status">Lengkapi nama, kontak, dan tujuan dulu — biar admin cepat bantu atur slot trial.</p>
  <button type="submit" class="mt-6 inline-flex min-h-[52px] w-full items-center justify-center gap-3 bg-accent px-6 font-mono text-[12px] font-medium uppercase tracking-[0.16em] text-paper transition-colors hover:bg-accent-deep active:scale-[0.98] sm:w-auto">
    Kirim &amp; lanjut trial
  </button>
  <p class="mt-3 text-xs text-steel">Tanpa komitmen. Balasan mengikuti jam operasional {gymName}.</p>
</form>
<script is:inline>
(function () {
  function init() {
  document.querySelectorAll('.trial-form').forEach(function (form) {
    form.addEventListener('submit', function (ev) {
      ev.preventDefault();
      var nama = form.querySelector('#tf-nama');
      var kontak = form.querySelector('#tf-kontak');
      var tujuan = form.querySelector('#tf-tujuan');
      var pesan = form.querySelector('#tf-pesan');
      var empty = form.querySelector('.form-empty');
      var ok = true;
      function setErr(input, id, msg) {
        var el = form.querySelector('#' + id);
        if (!el) return;
        if (msg) { el.textContent = msg; el.classList.remove('hidden'); input.setAttribute('aria-invalid', 'true'); ok = false; }
        else { el.textContent = ''; el.classList.add('hidden'); input.removeAttribute('aria-invalid'); }
      }
      var vNama = nama.value.trim();
      var vKontak = kontak.value.trim();
      setErr(nama, 'tf-nama-err', vNama.length < 2 ? 'Isi nama minimal 2 huruf.' : '');
      setErr(kontak, 'tf-kontak-err', vKontak.length < 3 ? 'Isi no. WA / username IG aktif.' : '');
      setErr(tujuan, 'tf-tujuan-err', !tujuan.value ? 'Pilih tujuan latihan dulu.' : '');
      empty.classList.toggle('hidden', ok);
      if (!ok) { (form.querySelector('[aria-invalid="true"]') || nama).focus(); return; }
      var kind = form.dataset.kind, action = form.dataset.action, gym = form.dataset.gym;
      var text = 'Halo ' + gym + ', saya ' + vNama + ' (' + vKontak + '). Tujuan: ' + tujuan.value + (pesan.value.trim() ? '. Catatan: ' + pesan.value.trim() : '') + ' Mau tanya slot trial.';
      var url = kind === 'maps' ? action : action + '?text=' + encodeURIComponent(text);
      if (kind === 'maps') {
        try { sessionStorage.setItem('trial-info', text); } catch (e) {}
        empty.textContent = 'Siap, ' + vNama + '! Info tujuan tersimpan — lanjut buka rute Google Maps ya.';
        empty.classList.remove('hidden');
      }
      window.open(url, '_blank', 'noopener');
    });
  });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
