---
import Icon from './Icon.astro';
import { business, waLink } from '../data/business';
interface Props { title?: string; lead?: string; message?: string; waLabel?: string; }
const {
  title = 'Mulai dari satu sesi coba',
  lead = 'Free trial 1x plus konsultasi. Tanpa komitmen — slot dikonfirmasi manual admin lewat WhatsApp.',
  message = `Halo ${business.name}, saya mau klaim free trial 1x. Apakah slot masih ada?`,
  waLabel = 'Chat WhatsApp',
} = Astro.props;
const cta = waLink(message);
---
<!-- Ref: CTA penutup — WA + Instagram sebagai teks/ikon SVG inline -->
<section class="mx-auto max-w-content px-4 py-12 md:px-6 md:py-20" aria-labelledby="cta-penutup">
  <div class="grid grid-cols-1 items-end gap-8 md:grid-cols-12">
    <div class="md:col-span-7">
      <p class="num text-[11px] uppercase tracking-[0.2em] text-marker">Langkah berikutnya</p>
      <h2 id="cta-penutup" class="mt-3 max-w-[18ch] font-display text-4xl font-bold uppercase leading-[0.95] tracking-tight md:text-6xl">{title}</h2>
      <p class="mt-4 max-w-[52ch] text-sm leading-relaxed text-steel">{lead}</p>
    </div>
    <div class="md:col-span-5">
      <div class="flex flex-col gap-3">
        <a href={cta} class="inline-flex min-h-[56px] items-center justify-between gap-4 bg-accent px-6 font-mono text-[12px] font-medium uppercase tracking-[0.16em] text-paper transition-colors hover:bg-accent-deep active:scale-[0.98]">
          <span class="inline-flex items-center gap-3"><Icon name="wa" size={20} /> {waLabel}</span>
          <span class="num text-paper/70">0812-9933-3289</span>
        </a>
        <a href={business.instagram} rel="me noopener" class="inline-flex min-h-[56px] items-center justify-between gap-4 border border-steel/40 px-6 font-mono text-[12px] font-medium uppercase tracking-[0.16em] text-paper transition-colors hover:border-marker hover:text-marker active:scale-[0.98]">
          <span class="inline-flex items-center gap-3"><Icon name="instagram" size={20} /> Instagram</span>
          <span class="num text-steel">@fortisfit_jambi</span>
        </a>
        <p class="num text-[11px] leading-relaxed text-steel">Balasan mengikuti jam operasional &mdash; {business.hours}.</p>
      </div>
    </div>
  </div>
</section>
