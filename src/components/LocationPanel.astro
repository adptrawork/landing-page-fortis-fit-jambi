---
import Icon from './Icon.astro';
import MapFacade from './MapFacade.astro';
import { business } from '../data/business';
interface Props { id?: string; eyebrow?: string; }
const { id = 'lokasi', eyebrow = 'Lokasi & jam operasional' } = Astro.props;
---
<!-- Ref: panel lokasi berwarna — blok accent penuh dengan teks paper + MapFacade klik-untuk-muat -->
<section id={id} class="mx-auto max-w-content px-4 py-12 md:px-6 md:py-20" aria-labelledby={`${id}-title`}>
  <div class="grid grid-cols-1 gap-px overflow-hidden bg-accent md:grid-cols-12">
    <div class="bg-accent p-7 text-paper md:col-span-5 md:p-10">
      <p class="num text-[11px] uppercase tracking-[0.2em] text-paper/80">{eyebrow}</p>
      <h2 id={`${id}-title`} class="mt-3 font-display text-3xl font-bold uppercase leading-[1] tracking-tight md:text-4xl">Mampir ke Paal Lima</h2>
      <dl class="mt-7 space-y-4">
        <div class="rule border-t border-paper/30 pt-3">
          <dt class="label text-paper/80">Alamat</dt>
          <dd class="mt-1 text-sm leading-relaxed">{business.address}.</dd>
        </div>
        <div class="rule border-t border-paper/30 pt-3">
          <dt class="label text-paper/80">Kawasan</dt>
          <dd class="mt-1 text-sm leading-relaxed">Paal Lima &mdash; Jl. Pangeran Hidayat, Kota Jambi (sumber Linktree publik, konfirmasi via IG/WA).</dd>
        </div>
        <div class="rule border-t border-paper/30 pt-3">
          <dt class="label text-paper/80">Jam</dt>
          <dd class="num mt-1 text-sm leading-relaxed">{business.hours}.</dd>
        </div>
      </dl>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={business.mapsUrl} rel="noopener" class="inline-flex min-h-[48px] items-center gap-2 bg-paper px-5 font-mono text-[11px] font-medium uppercase tracking-[0.16em] text-ink transition-transform hover:-translate-y-0.5 active:scale-[0.98]">
          <Icon name="pin" size={16} /> Buka rute
        </a>
        <a href={business.instagram} rel="me noopener" class="inline-flex min-h-[48px] items-center gap-2 border border-paper/50 px-5 font-mono text-[11px] font-medium uppercase tracking-[0.16em] text-paper transition-colors hover:bg-paper/10 active:scale-[0.98]">
          <Icon name="instagram" size={16} /> Instagram
        </a>
      </div>
    </div>
    <div class="bg-ink-deep p-3 md:col-span-7 md:p-4">
      <MapFacade src={business.mapsEmbed} title="Peta Fortis Fit Jambi" mapsUrl={business.mapsUrl} />
    </div>
  </div>
</section>
