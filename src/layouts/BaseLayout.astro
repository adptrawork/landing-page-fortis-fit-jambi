---
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';
interface Props { title: string; description: string; canonicalPath?: string; image?: string; }
const { title, description, canonicalPath = '/', image } = Astro.props;
const site = (Astro.site?.toString() ?? 'https://fortisfit-jambi.pages.dev').replace(/\/$/, '');
const canonicalUrl = `${site}${canonicalPath}`;
import { business, waLink } from '../data/business';
const cta = waLink(`Halo ${business.name}, saya mau tanya free trial. Apakah slot masih ada?`);
---
<!doctype html>
<html lang="id">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} image={image} />
</head>
<body class="bg-orange-50 text-stone-900 antialiased">
  <header class="sticky top-0 z-40 bg-stone-900 text-orange-50">
    <nav class="max-w-7xl mx-auto flex items-center justify-between px-4 py-3">
      <a href="/" class="flex items-center gap-2.5">
        <span class="grid place-items-center w-9 h-9 rounded-xl bg-orange-700 text-white font-black italic" aria-hidden="true">F</span>
        <span class="font-black tracking-tight uppercase leading-none">Fortis Fit<small class="block text-[10px] font-bold tracking-[0.2em] text-orange-300">Jambi &bull; Gym + Kelas</small></span>
      </a>
      <div class="hidden md:flex gap-6 text-sm font-bold uppercase tracking-wide text-orange-100/80">
        <a href="/" class="hover:text-white transition">Beranda</a>
        <a href="/program" class="hover:text-white transition">Program</a>
        <a href="/pelatih" class="hover:text-white transition">Pelatih</a>
        <a href="/harga" class="hover:text-white transition">Harga</a>
        <a href="/kontak" class="hover:text-white transition">Kontak</a>
      </div>
      <a href={cta} class="bg-orange-700 text-white px-5 py-2.5 rounded-full text-sm font-bold uppercase tracking-wide transition-all duration-300 hover:bg-orange-800 active:scale-[0.98]" style="transition-timing-function:cubic-bezier(0.16,1,0.3,1)">Free Trial</a>
    </nav>
  </header>
  <main><slot /></main>
  <footer class="mt-20 bg-stone-900 text-orange-50">
    <div class="max-w-7xl mx-auto px-4 py-12 grid gap-8 grid-cols-1 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="font-black uppercase tracking-tight text-xl">Fortis Fit Jambi</p>
        <p class="mt-2 text-sm text-orange-200/80 font-bold uppercase tracking-widest">Buka Sen–Jum 07–22 &bull; Sab–Min 07–18</p>
        <p class="mt-2 text-base text-orange-100/70 leading-relaxed max-w-[65ch]">{business.address} — {business.hours}</p>
      </div>
      <div class="md:col-span-5">
        <p class="font-bold text-sm uppercase tracking-widest">Gas hubungi</p>
        <div class="mt-3 flex flex-col gap-2 text-sm font-medium">
          <a href={`https://wa.me/${business.phone}`} class="underline underline-offset-4">WA 0812-9933-3289</a>
          <a href={business.instagram} class="underline underline-offset-4">Instagram @fortisfit_jambi</a>
          <a href={business.mapsUrl} class="underline underline-offset-4">Google Maps — rute ke lokasi</a>
        </div>
        <p class="mt-6 text-xs text-orange-100/40">© 2026 Fortis Fit — Kota Jambi.</p>
      </div>
    </div>
  </footer>
<script is:inline>
document.addEventListener('pointermove', function(e) {
  var t = e.target.closest && e.target.closest('.dir-fill');
  if (!t) return;
  var r = t.getBoundingClientRect();
  t.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100) + '%');
  t.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100) + '%');
}, { passive: true });
</script>
</body>
</html>
