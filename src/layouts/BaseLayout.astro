---
import BaseHead from '../components/BaseHead.astro';
import Icon from '../components/Icon.astro';
import '../styles/global.css';
interface Props { title: string; description: string; canonicalPath?: string; image?: string; breadcrumb?: string; }
const { title, description, canonicalPath = '/', image, breadcrumb } = Astro.props;
const rawSite = Astro.site?.toString() ?? 'https://landing-page-fortis-fit-jambi.adi-putra-work1.workers.dev';
const site = rawSite.replace(/\/$/, '');
const canonicalUrl = `${site}${canonicalPath}`;
import { business, waLink } from '../data/business';
const cta = waLink(`Halo ${business.name}, saya mau klaim free trial 1x. Apakah slot masih ada?`);
const waDirect = `https://wa.me/${business.phone}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const navItems = [
  { href: '/', label: 'Beranda' },
  { href: '/program', label: 'Program' },
  { href: '/pelatih', label: 'Pelatih' },
  { href: '/harga', label: 'Harga' },
  { href: '/kontak', label: 'Kontak' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="id">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} image={image} breadcrumb={breadcrumb} />
</head>
<body class="min-h-[100dvh] bg-ink font-display text-paper antialiased">
  <a href="#main" class="skip-link font-mono text-sm">Langsung ke konten</a>

  <!-- Utility bar: data mono, bukan klaim promosi -->
  <div class="rule border-b border-steel/20 bg-ink-deep">
    <p class="num mx-auto flex max-w-content flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2 text-[10px] uppercase tracking-[0.16em] text-steel md:px-6">
      <span>{business.followers}</span>
      <span aria-hidden="true" class="text-steel/40">/</span>
      <span>Sen&ndash;Jum 07&ndash;22 &middot; Sab&ndash;Min 07&ndash;18</span>
      <span aria-hidden="true" class="text-steel/40">/</span>
      <span class="text-marker">Free trial 1x</span>
    </p>
  </div>

  <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Buka atau tutup menu navigasi" />
  <header class="site-header sticky top-0 z-50 border-b border-steel/20 bg-ink/90 backdrop-blur-xl">
    <nav class="mx-auto flex max-w-content items-center justify-between gap-3 px-4 py-3 md:px-6" aria-label="Navigasi utama">
      <a href="/" class="flex min-h-[48px] items-center gap-3">
        <span class="grid h-9 w-9 place-items-center border border-marker/70 font-display text-lg font-bold text-marker" aria-hidden="true">F</span>
        <span class="font-display font-bold uppercase leading-none tracking-tight">Fortis Fit
          <small class="mt-1 block font-mono text-[10px] font-medium tracking-[0.22em] text-steel">Jambi &middot; Gym + Kelas</small>
        </span>
      </a>
      <div class="hidden items-center gap-7 font-mono text-[11px] uppercase tracking-[0.16em] text-steel md:flex">
        {navItems.map((n) => (
          <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined} class:list={["inline-flex min-h-[48px] items-center transition-colors hover:text-paper", isActive(n.href) && "marker-mark text-paper"]}>{n.label}</a>
        ))}
      </div>
      <div class="flex items-center gap-2">
        <a href={cta} class="hidden min-h-[48px] items-center gap-2 bg-accent px-5 font-mono text-[11px] font-medium uppercase tracking-[0.16em] text-paper transition-colors hover:bg-accent-deep active:scale-[0.98] sm:inline-flex">
          Klaim Free Trial
        </a>
        <label for="nav-toggle" class="burger grid min-h-[48px] min-w-[48px] cursor-pointer place-items-center border border-steel/30 text-paper md:hidden">
          <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
          <span class="sr-only">Menu</span>
        </label>
      </div>
      <div class="mobile-menu absolute inset-x-0 top-full border-b border-steel/20 bg-ink shadow-2xl md:hidden">
        <div class="flex flex-col px-4 py-3 font-mono text-[11px] uppercase tracking-[0.16em]">
          {navItems.map((n) => (
            <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined} class:list={["inline-flex min-h-[48px] items-center rule border-b border-steel/15", isActive(n.href) && "text-marker"]}>{n.label}</a>
          ))}
          <a href={cta} class="mt-3 inline-flex min-h-[48px] items-center justify-center bg-accent font-mono text-[11px] uppercase tracking-[0.16em] text-paper">Klaim Free Trial</a>
        </div>
      </div>
    </nav>
  </header>

  <main id="main"><slot /></main>

  <footer class="rule mt-20 border-t border-steel/25 bg-ink-deep">
    <div class="mx-auto grid max-w-content grid-cols-1 gap-10 px-4 py-14 md:grid-cols-12 md:px-6">
      <div class="md:col-span-5">
        <p class="font-display text-2xl font-bold uppercase tracking-tight">Fortis Fit Jambi</p>
        <p class="label mt-1 text-marker">{business.category}</p>
        <p class="mt-4 max-w-[42ch] text-sm leading-relaxed text-steel">
          {business.address}.<br />
          Kawasan Paal Lima &mdash; Jl. Pangeran Hidayat, Kota Jambi (sumber Linktree publik).<br />
          {business.hours}.
        </p>
      </div>
      <div class="md:col-span-4">
        <p class="label text-steel">Kontak</p>
        <div class="mt-4 flex flex-col gap-1 text-sm">
          <a href={waDirect} class="inline-flex min-h-[48px] items-center gap-3 text-paper underline-offset-4 hover:text-marker hover:underline"><Icon name="wa" size={18} /> WA 0812-9933-3289</a>
          <a href={business.instagram} rel="me noopener" class="inline-flex min-h-[48px] items-center gap-3 text-paper underline-offset-4 hover:text-marker hover:underline"><Icon name="instagram" size={18} /> @fortisfit_jambi</a>
          <a href={business.mapsUrl} rel="noopener" class="inline-flex min-h-[48px] items-center gap-3 text-paper underline-offset-4 hover:text-marker hover:underline"><Icon name="pin" size={18} /> Rute Google Maps</a>
        </div>
      </div>
      <div class="md:col-span-3">
        <p class="label text-steel">Jam operasional</p>
        <dl class="mt-4 space-y-2 text-sm">
          <div class="flex items-baseline justify-between gap-4 rule border-t border-steel/15 pt-2">
            <dt class="text-steel">Sen&ndash;Jum</dt><dd class="num text-paper">07.00&ndash;22.00</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 rule border-t border-steel/15 pt-2">
            <dt class="text-steel">Sab&ndash;Min</dt><dd class="num text-paper">07.00&ndash;18.00</dd>
          </div>
        </dl>
      </div>
    </div>
    <div class="rule border-t border-steel/20">
      <div class="mx-auto flex max-w-content flex-col gap-2 px-4 py-5 md:flex-row md:items-center md:justify-between md:px-6">
        <p class="num text-[11px] text-steel">&copy; 2026 Fortis Fit &mdash; Kota Jambi. Harga &amp; jadwal bersifat estimasi, konfirmasi via WA.</p>
        <p class="num text-[11px] text-steel">Kredit gambar: dokumentasi Fortis Fit &amp; Wikimedia Commons (CC0/CC BY-SA).</p>
      </div>
    </div>
  </footer>
</body>
</html>
