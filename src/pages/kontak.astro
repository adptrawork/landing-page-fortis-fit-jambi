---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import LocationPanel from '../components/LocationPanel.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { business, waLink } from '../data/business';
const waAsk = waLink(`Halo ${business.name}, saya mau tanya jadwal kelas dan slot free trial.`);
const pageDescription =
  'Kontak resmi Fortis Fit Jambi: WA 0812-9933-3289, Instagram @fortisfit_jambi, dan rute Maps ke Paal Lima. Buka Sen–Jum 07–22, Sab–Min 07–18 WIB.';
const channels = [
  { k: 'WhatsApp', v: '0812-9933-3289', href: `https://wa.me/${business.phone}`, icon: 'wa' as const, note: 'Nomor resmi dari bio Instagram' },
  { k: 'Instagram', v: '@fortisfit_jambi', href: business.instagram, icon: 'instagram' as const, note: 'Jadwal kelas & price list ada di postingan/reel' },
  { k: 'Google Maps', v: 'Rute ke lokasi', href: business.mapsUrl, icon: 'pin' as const, note: 'Kawasan Paal Lima, Kota Jambi' },
];
---
<!-- Ref: technical performance editorial — panel lokasi berwarna + kanal kontak ber-rule -->
<BaseLayout title="Kontak & lokasi Fortis Fit Jambi, Paal Lima — Kota Jambi" description={pageDescription} canonicalPath="/kontak" image={business.ogImage} breadcrumb="Kontak">

  <section class="bg-ink" aria-labelledby="subhead">
    <div class="mx-auto max-w-content px-4 pb-10 pt-12 md:px-6 md:pb-14 md:pt-16">
      <nav class="num text-[11px] uppercase tracking-[0.16em] text-steel" aria-label="Breadcrumb">
        <a href="/" class="hover:text-marker">Beranda</a> <span class="text-steel/50">/</span> Kontak
      </nav>
      <h1 id="subhead" class="rise mt-4 max-w-[20ch] font-display text-[clamp(2.2rem,6.5vw,4.5rem)] font-bold uppercase leading-[0.92] tracking-[-0.03em]" style="--i:1">Hubungi &amp; kunjungi</h1>
      <p class="rise mt-4 max-w-[58ch] text-base leading-relaxed text-steel" style="--i:2">Satu sumber kebenaran untuk kontak, jam operasional, dan rute. Balasan mengikuti jam buka gym.</p>
      <a href={waAsk} class="rise mt-7 inline-flex min-h-[52px] items-center gap-2 bg-accent px-6 font-mono text-[12px] font-medium uppercase tracking-[0.16em] text-paper transition-colors hover:bg-accent-deep active:scale-[0.98]" style="--i:3">
        <Icon name="wa" size={18} /> Chat WhatsApp
      </a>
    </div>
  </section>

  <!-- Panel lokasi berwarna + MapFacade klik-untuk-muat -->
  <LocationPanel id="lokasi" eyebrow="Lokasi, jam & peta" />

  <section class="mx-auto max-w-content px-4 pb-12 md:px-6 md:pb-16" aria-labelledby="kanal">
    <SectionHead index="01" label="Kanal resmi" title="Pilih cara menghubungi" note="3 kanal" id="kanal" />
    <ul class="mt-10">
      {channels.map((c) => (
        <li class="rule border-t border-steel/25">
          <a href={c.href} rel="noopener" class="group grid grid-cols-1 items-baseline gap-2 py-6 md:grid-cols-12 md:gap-4">
            <span class="flex items-center gap-3 md:col-span-3">
              <Icon name={c.icon} size={20} class="text-marker" />
              <span class="label text-steel">{c.k}</span>
            </span>
            <span class="font-display text-xl font-bold uppercase tracking-tight text-paper transition-colors group-hover:text-marker md:col-span-4">{c.v}</span>
            <span class="text-sm text-steel md:col-span-4">{c.note}</span>
            <span class="num text-right text-[11px] uppercase tracking-[0.14em] text-steel md:col-span-1"><Icon name="external" size={16} class="inline" /></span>
          </a>
        </li>
      ))}
    </ul>
    <p class="num mt-6 max-w-[80ch] text-[11px] leading-relaxed uppercase tracking-[0.14em] text-steel">
      Alamat lengkap mengikuti koordinasi IG/WA &mdash; kawasan dari Linktree publik. Konfirmasi sebelum datang pertama kali.
    </p>
  </section>

  <CtaBand
    title="Amankan slot trial-mu"
    lead="Free trial 1x plus konsultasi. Kirim pesan singkat, admin bantu atur waktunya."
    message={`Halo ${business.name}, saya mau klaim free trial 1x dan tanya jadwal kelas.`}
    waLabel="Klaim free trial"
  />
</BaseLayout>
