---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, waLink } from '../data/business';
---
<BaseLayout title="Kontak Fortis Fit Jambi — WA Trial & Rute Lokasi" description="Hubungi Fortis Fit Jambi via WA 0812-9933-3289 untuk free trial. Buka Sen–Jum 07–22, weekend 07–18. Rute via Google Maps." canonicalPath="/kontak">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-7">
        <p class="text-xs font-black uppercase tracking-[0.2em] text-orange-700">Kontak</p>
        <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-black uppercase">Amankan slot trial-mu</h1>
        <p class="mt-3 text-base text-stone-600 max-w-[65ch]">Isi nama, salin format chat, kirim ke WA resmi <strong>0812-9933-3289</strong> (dari bio IG).</p>
        <div class="mt-8 bg-white border border-orange-700/20 rounded-[2.5rem] p-8 space-y-4">
          <div><label for="nama" class="text-sm font-bold uppercase tracking-wide">Nama</label><input id="nama" placeholder="Nama kamu" class="mt-1 w-full border border-stone-300 rounded-2xl px-4 py-3 min-h-[48px] bg-orange-50/50" /></div>
          <div><label for="tujuan" class="text-sm font-bold uppercase tracking-wide">Tujuan</label><select id="tujuan" class="mt-1 w-full border border-stone-300 rounded-2xl px-4 py-3 min-h-[48px] bg-orange-50/50"><option>Free Trial 1x</option><option>Tanya Member</option><option>Jadwal Kelas</option></select></div>
          <div class="flex flex-wrap gap-3">
            <button id="copy" class="bg-orange-700 text-white px-7 py-3.5 rounded-full font-bold uppercase tracking-wide text-sm active:scale-[0.98]">Salin &amp; Kirim WA</button>
            <a href={business.instagram} class="dir-fill border border-stone-300 px-7 py-3.5 rounded-full font-bold uppercase tracking-wide text-sm">IG @fortisfit_jambi</a>
          </div>
          <p id="ok" class="hidden text-sm text-orange-700 font-semibold">Tersalin — tempel di WA 0812-9933-3289.</p>
        </div>
      </div>
      <div class="md:col-span-5">
        <div class="bg-stone-900 text-orange-50 rounded-[2.5rem] p-8">
          <p class="font-black uppercase tracking-tight text-lg">Info kunjungan</p>
          <p class="mt-2 text-sm text-orange-100/70">{business.address}</p>
          <p class="mt-1 font-mono-num text-sm">{business.hours}</p>
          <p class="mt-1 text-sm text-orange-100/70">IG: @fortisfit_jambi ({business.followers})</p>
          <a class="mt-4 inline-block underline underline-offset-4 font-semibold" href={business.mapsUrl}>Rute ke lokasi</a>
        </div>
      </div>
    </div>
    <div class="mt-8 rounded-[2.5rem] overflow-hidden border border-orange-700/20 aspect-video bg-orange-100">
      <iframe title="Peta Fortis Fit Jambi" src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
    </div>
  </section>
<script is:inline>
document.getElementById('copy').addEventListener('click', function() {
  var nama = (document.getElementById('nama').value || '').trim() || '[nama]';
  var tujuan = document.getElementById('tujuan').value;
  var msg = 'Halo Fortis Fit, saya ' + nama + '. Mau ' + tujuan + '. Apakah slot masih ada?';
  navigator.clipboard.writeText(msg).then(function() {
    document.getElementById('ok').classList.remove('hidden');
    window.open('https://wa.me/6281299333289?text=' + encodeURIComponent(msg), '_blank');
  });
});
</script>
</BaseLayout>
