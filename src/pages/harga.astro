---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import PriceCompare from '../components/PriceCompare.astro';
import CtaBand from '../components/CtaBand.astro';
import { business, prices, waLink } from '../data/business';
const heroCta = waLink(`Halo ${business.name}, saya mau tanya tarif akhir paket dan slot free trial.`);
const pageDescription =
  'Harga Fortis Fit Jambi: free trial, harian, mingguan, bulanan, personal trainer, tahunan. Harga estimasi dari price list IG — konfirmasi tarif akhir via WA.';
const labels = [
  { k: 'Terverifikasi', v: 'Tercantum di bio/reel Instagram resmi atau Linktree publik.' },
  { k: 'Estimasi', v: 'Belum dipastikan pemilik — konfirmasi tarif via WA sebelum bayar.' },
  { k: 'Klaim — cek IG', v: 'Promo yang disebut di reel price list IG; kuota dan syarat dicek admin.' },
];
---
<!-- Ref: technical performance editorial — daftar harga bernomor, tabel runtuh jadi kartu -->
<BaseLayout title="Harga & paket Fortis Fit Jambi — harian sampai tahunan" description={pageDescription} canonicalPath="/harga" image={business.ogImage} breadcrumb="Harga">

  <section class="bg-ink" aria-labelledby="subhead">
    <div class="mx-auto max-w-content px-4 pb-10 pt-12 md:px-6 md:pb-14 md:pt-16">
      <nav class="num text-[11px] uppercase tracking-[0.16em] text-steel" aria-label="Breadcrumb">
        <a href="/" class="hover:text-marker">Beranda</a> <span class="text-steel/50">/</span> Harga
      </nav>
      <h1 id="subhead" class="rise mt-4 max-w-[20ch] font-display text-[clamp(2.2rem,6.5vw,4.5rem)] font-bold uppercase leading-[0.92] tracking-[-0.03em]" style="--i:1">Harga terbuka, tanpa biaya tersembunyi</h1>
      <p class="rise mt-4 max-w-[58ch] text-base leading-relaxed text-steel" style="--i:2">Enam paket dengan label sumber yang jelas. Semua harga ditandai estimasi sampai dikonfirmasi admin.</p>
      <a href={heroCta} class="rise mt-7 inline-flex min-h-[52px] items-center gap-2 bg-accent px-6 font-mono text-[12px] font-medium uppercase tracking-[0.16em] text-paper transition-colors hover:bg-accent-deep active:scale-[0.98]" style="--i:3">
        Konfirmasi tarif
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-content px-4 py-12 md:px-6 md:py-16" aria-labelledby="daftar-harga">
    <SectionHead index="01" label="Daftar harga" title="Pilih paketmu" note="6 paket" id="daftar-harga" />
    <div class="mt-10">
      <PriceCompare
        items={prices.map((p) => ({ ...p, href: heroCta }))}
        note="Harga estimasi mengacu pada reel price list IG @fortisfit_jambi. Free trial 1x + konsultasi disebut di reel yang sama. Tarif akhir, syarat, dan masa berlaku dikonfirmasi via WA 0812-9933-3289."
      />
    </div>
  </section>

  <section class="mx-auto max-w-content px-4 pb-12 md:px-6 md:pb-16" aria-labelledby="label">
    <SectionHead index="02" label="Cara baca label" title="Apa arti tiap tanda" note="Transparansi data" id="label" />
    <ul class="mt-10">
      {labels.map((l) => (
        <li class="rule grid grid-cols-1 gap-2 border-t border-steel/25 py-5 md:grid-cols-12 md:items-baseline">
          <p class="label text-marker md:col-span-3">{l.k}</p>
          <p class="max-w-[70ch] text-sm leading-relaxed text-steel md:col-span-9">{l.v}</p>
        </li>
      ))}
    </ul>
  </section>

  <CtaBand
    title="Kunci tarif terbaikmu"
    lead="Tanya slot dan tarif akhir — gratis, tanpa komitmen, dibalas sesuai jam operasional."
    message={`Halo ${business.name}, saya mau tanya tarif akhir dan slot free trial.`}
    waLabel="Tanya tarif"
  />
</BaseLayout>
