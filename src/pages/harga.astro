---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, prices, waLink } from '../data/business';
---
<BaseLayout title="Harga Fortis Fit Jambi — Free Trial & Member Termurah" description="Harga Fortis Fit Jambi: free trial Rp 0, estimasi harian, mingguan, bulanan, PT. Price list resmi di reel IG @fortisfit_jambi — konfirmasi via WA." canonicalPath="/harga">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <p class="text-xs font-black uppercase tracking-[0.2em] text-orange-700">Harga</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-black uppercase">Trial gratis, member enteng</h1>
    <p class="mt-3 text-base text-stone-600 max-w-[65ch]">Price list resmi ada di <strong>reel IG @fortisfit_jambi</strong>. Angka di bawah estimasi — wajib konfirmasi via WA sebelum bayar.</p>
  </section>
  <section class="pb-4" aria-label="Daftar harga">
    <div class="snap-rail no-scrollbar flex gap-5 overflow-x-auto px-4 md:px-[max(1rem,calc((100vw-80rem)/2+1rem))] pb-2">
      {prices.map((p, i) => (
        <article class={`shrink-0 w-[82vw] sm:w-[380px] rounded-[2.5rem] p-8 border active:scale-[0.98] ${i === 0 ? 'bg-stone-900 text-orange-50 border-stone-900' : 'bg-white border-orange-700/20'}`}>
          <p class={`font-mono-num text-xs font-bold ${i === 0 ? 'text-orange-300' : 'text-orange-700'}`}>0{i + 1} — {p.badge}</p>
          <h2 class="mt-2 font-black uppercase tracking-tight text-xl">{p.name}</h2>
          <p class="mt-2 font-mono-num font-bold text-2xl">{p.price}</p>
          <p class={`mt-2 text-sm ${i === 0 ? 'text-orange-100/70' : 'text-stone-600'}`}>{p.desc}</p>
          <a href={waLink(`Halo ${business.name}, saya mau tanya paket ${p.name} (${p.price}).`)} class={`dir-fill mt-6 inline-block px-6 py-3 rounded-full text-sm font-bold uppercase tracking-wide border ${i === 0 ? 'border-orange-300/60' : 'border-stone-300'}`}>Tanya via WA</a>
        </article>
      ))}
    </div>
    <p class="max-w-7xl mx-auto px-4 mt-4 text-xs text-stone-400">Geser kartu ke samping — tiap kartu bisa dikonfirmasi langsung via WA.</p>
  </section>
</BaseLayout>
