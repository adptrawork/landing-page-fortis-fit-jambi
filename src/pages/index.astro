---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import ProgramRow from '../components/ProgramRow.astro';
import StatsStrip from '../components/StatsStrip.astro';
import LocationPanel from '../components/LocationPanel.astro';
import CtaBand from '../components/CtaBand.astro';
import TrialForm from '../components/TrialForm.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { business, programs, waLink } from '../data/business';

const heroCta = waLink(`Halo ${business.name}, saya mau klaim free trial 1x. Apakah slot masih ada?`);
const pageDescription =
  'Latihan di Fortis Fit Jambi, Paal Lima: area beban & kardio, kelas aerobik dan yoga, sauna, bilas. Buka Sen–Jum 07–22, weekend 07–18. Klaim free trial via WA.';

const specs = [
  { k: 'Lokasi', v: 'Paal Lima, Kota Jambi' },
  { k: 'Buka', v: 'Sen–Jum 07–22' },
  { k: 'Weekend', v: 'Sab–Min 07–18' },
  { k: 'Trial', v: '1x + konsultasi' },
];

const metrics = [
  { value: '4.140', label: 'Pengikut Instagram', note: 'Terverifikasi' },
  { value: '07–22', label: 'Jam buka Sen–Jum', note: 'Terverifikasi' },
  { value: '07–18', label: 'Jam buka Sab–Min', note: 'Terverifikasi' },
  { value: '1x', label: 'Free trial + konsultasi', note: 'Klaim IG' },
];

const facilities = [
  { name: 'Kamar mandi / bilas', badge: 'Terverifikasi', note: 'Bio IG menyebut Bathrooms' },
  { name: 'Kelas grup (aerobik & yoga)', badge: 'Terverifikasi', note: 'Bio IG menyebut Classes' },
  { name: 'Area beban & kardio', badge: 'Terverifikasi', note: 'Bio IG menyebut Gym' },
  { name: 'Sauna & pemulihan', badge: 'Terverifikasi', note: 'Masuk skema layanan' },
];

const faqs = [
  { q: 'Apakah benar ada free trial?', a: 'Ya — reel price list di IG @fortisfit_jambi menyebut free trial 1x + konsultasi. Konfirmasi slot via WA 0812-9933-3289 karena kuota harian terbatas.' },
  { q: 'Jam berapa gym buka?', a: 'Senin–Jumat 07.00–22.00, Sabtu–Minggu 07.00–18.00 WIB — sesuai bio IG resmi.' },
  { q: 'Pemula boleh ikut kelas grup?', a: 'Boleh. Info ke instruktur kalau baru pertama latihan, dan konfirmasi jadwal kelas terbaru lewat postingan IG atau WA.' },
  { q: 'Apakah ada kamar mandi / bilas?', a: 'Ada — bio IG resmi menyebut Bathrooms. Cocok latihan sebelum atau sesudah aktivitas.' },
  { q: 'Harga di web ini pasti?', a: 'Harga paket bersifat estimasi — acuan reel price list IG. Konfirmasi tarif akhir via WA sebelum bayar.' },
];

const metaFor = (badge: string) => [
  `Status~${badge}`,
  'Konfirmasi~IG / WA admin',
];
---
<!-- Ref: technical performance editorial — headline oversized asimetris + indeks program bernomor -->
<BaseLayout title={business.title} description={pageDescription} canonicalPath="/" image={business.ogImage} breadcrumb="Beranda">

  <!-- 01 HERO: asimetris, headline oversized, angka mono, CTA — dilarang center -->
  <section class="relative overflow-hidden bg-ink" aria-labelledby="hero">
    <div class="mx-auto grid max-w-content grid-cols-1 items-center gap-10 px-4 py-14 md:px-6 md:py-20 lg:min-h-[100dvh] lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <p class="label rise text-accent" style="--i:0">Gym + kelas &middot; Kota Jambi</p>
        <h1 id="hero" class="rise mt-4 font-display text-[clamp(2.6rem,8.4vw,6rem)] font-bold uppercase leading-[0.9] tracking-[-0.03em]" style="--i:1">
          Latihan yang<br />terukur, bukan<br /><span class="marker-mark">sekadar niat</span>
        </h1>
        <p class="rise mt-6 max-w-[54ch] text-base leading-relaxed text-steel" style="--i:2">
          Area beban &amp; kardio, kelas grup aerobik dan yoga, sauna, serta kamar mandi bilas. Pusat kebugaran di Paal Lima, Jl. Pangeran Hidayat, Kota Jambi.
        </p>
        <div class="rise mt-8 flex flex-wrap gap-3" style="--i:3">
          <a href={heroCta} class="inline-flex min-h-[52px] items-center gap-2 bg-accent px-6 font-mono text-[12px] font-medium uppercase tracking-[0.16em] text-paper transition-colors hover:bg-accent-deep active:scale-[0.98]">
            <Icon name="wa" size={18} /> Klaim free trial
          </a>
          <a href="/program" class="inline-flex min-h-[52px] items-center gap-2 border border-steel/40 px-6 font-mono text-[12px] font-medium uppercase tracking-[0.16em] text-paper transition-colors hover:border-marker hover:text-marker active:scale-[0.98]">
            Lihat program <Icon name="arrow" size={16} />
          </a>
        </div>
        <p class="num rise mt-6 text-[11px] uppercase tracking-[0.16em] text-steel" style="--i:4">
          Program inti: open gym + kelas grup &middot; kelas lain cek jadwal IG
        </p>
      </div>

      <div class="rise lg:col-span-5" style="--i:2">
        <dl class="rule border-t border-steel/25">
          {specs.map((s) => (
            <div class="rule flex items-baseline justify-between gap-6 border-t border-steel/25 py-4">
              <dt class="label text-steel">{s.k}</dt>
              <dd class="num text-sm text-paper">{s.v}</dd>
            </div>
          ))}
        </dl>
        <img src="/images/fortis-fit-1.jpg" alt="Rak dumbel area beban gym Fortis Fit Jambi" width="800" height="533" loading="eager" fetchpriority="high" decoding="async" class="cut-lr mt-8 aspect-[16/10] w-full object-cover" />
        <p class="num mt-3 text-[10px] uppercase tracking-[0.14em] text-steel">Foto konteks area beban &mdash; ganti dengan foto lokasi asli.</p>
      </div>
    </div>
  </section>

  <!-- 02 GAMBAR DIAGONAL: potongan miring ringan, statis saat reduced motion -->
  <section class="relative overflow-hidden bg-ink" aria-label="Suasana latihan">
    <img src="/images/fortis-fit-2.jpg" alt="Suasana kelas grup aerobik di gym Fortis Fit Jambi" width="800" height="533" loading="lazy" decoding="async" class="cut-lr h-[46vh] min-h-[280px] w-full object-cover md:h-[64vh]" />
    <div class="num mx-auto flex max-w-content flex-wrap items-center justify-between gap-x-8 gap-y-2 px-4 py-4 text-[10px] uppercase tracking-[0.16em] text-steel md:px-6">
      <span>Arena latihan &mdash; kelas grup &amp; area beban</span>
      <span>Kredit: dokumentasi Fortis Fit / Wikimedia Commons (CC)</span>
    </div>
  </section>

  <!-- Ticker fasilitas (dekoratif, mono) -->
  <div class="rule marquee border-y border-steel/25 bg-ink-deep py-3" aria-label="Sorotan fasilitas">
    <div class="marquee-track num text-[11px] uppercase tracking-[0.24em] text-steel">
      <div class="flex shrink-0">
        {['Area beban', 'Kardio', 'Aerobik', 'Yoga', 'Sauna', 'Kamar mandi', 'Kelas grup', 'Free trial'].map((t) => (
          <span class="whitespace-nowrap px-6"><span class="text-marker" aria-hidden="true">/</span> {t}</span>
        ))}
      </div>
      <div class="flex shrink-0" aria-hidden="true">
        {['Area beban', 'Kardio', 'Aerobik', 'Yoga', 'Sauna', 'Kamar mandi', 'Kelas grup', 'Free trial'].map((t) => (
          <span class="whitespace-nowrap px-6"><span class="text-marker">/</span> {t}</span>
        ))}
      </div>
    </div>
  </div>

  <!-- 03 DAFTAR PROGRAM EDITORIAL: indeks bernomor 01... -->
  <section class="mx-auto max-w-content px-4 py-12 md:px-6 md:py-20" aria-labelledby="program">
    <SectionHead index="01" label="Program & kelas" title="Indeks latihan yang bisa diikuti" note="5 entri" id="program" />
    <div class="mt-10">
      {programs.map((p, i) => (
        <ProgramRow
          index={String(i + 1).padStart(2, '0')}
          name={p.name}
          desc={p.desc}
          badge={p.badge}
          img={p.img}
          alt={p.alt}
          meta={metaFor(p.badge)}
          href="/program"
          ctaLabel="Detail program"
        />
      ))}
    </div>
    <p class="num mt-8 text-[11px] uppercase tracking-[0.14em] text-steel">
      Label <span class="text-marker">Terverifikasi</span> = klaim bio/reel IG resmi. Label <span class="text-steel">Estimasi</span> = konfirmasi via WA.
    </p>
  </section>

  <!-- 04 FASILITAS: grid asimetris 2fr 1fr 1fr + list ber-rule -->
  <section class="mx-auto max-w-content px-4 py-12 md:px-6 md:py-20" aria-labelledby="fasilitas">
    <SectionHead index="02" label="Fasilitas & alat" title="Isi ruang latihannya" note="Berdasarkan bio IG" id="fasilitas" />
    <div class="mt-10 grid grid-cols-1 gap-px bg-steel/20 md:grid-cols-[2fr_1fr_1fr]">
      <article class="bg-ink p-5 md:p-7">
        <img src="/images/fortis-fit-1.jpg" alt="Rak dumbel dan alat beban di area latihan Fortis Fit Jambi" width="800" height="533" loading="lazy" decoding="async" class="cut-lr aspect-[16/10] w-full object-cover" />
        <h3 class="mt-5 font-display text-xl font-bold uppercase tracking-tight md:text-2xl">Area beban &amp; kardio</h3>
        <p class="mt-2 max-w-[46ch] text-sm leading-relaxed text-steel">Rak dumbel dan peralatan beban bebas untuk latihan kekuatan, ditambah zona kardio. Bio IG resmi menyebut <em>Gym</em>.</p>
      </article>
      <article class="flex flex-col bg-ink p-5 md:p-7">
        <img src="/images/fortis-fit-6.jpg" alt="Kelas yoga dan mobilitas di Fortis Fit Jambi" width="800" height="533" loading="lazy" decoding="async" class="cut-lr aspect-[4/3] w-full object-cover" />
        <h3 class="mt-5 font-display text-lg font-bold uppercase tracking-tight">Kelas yoga</h3>
        <p class="num mt-2 text-[11px] uppercase tracking-[0.14em] text-steel">Jadwal via IG</p>
      </article>
      <article class="flex flex-col bg-ink p-5 md:p-7">
        <img src="/images/fortis-fit-5.jpg" alt="Interior sauna kayu area pemulihan Fortis Fit Jambi" width="800" height="600" loading="lazy" decoding="async" class="cut-lr aspect-[4/3] w-full object-cover" />
        <h3 class="mt-5 font-display text-lg font-bold uppercase tracking-tight">Sauna</h3>
        <p class="num mt-2 text-[11px] uppercase tracking-[0.14em] text-steel">Area pemulihan</p>
      </article>
    </div>
    <ul class="mt-8">
      {facilities.map((f) => (
        <li class="rule flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-t border-steel/25 py-4">
          <p class="font-display text-base font-bold tracking-tight md:text-lg">{f.name}</p>
          <p class="num text-[11px] uppercase tracking-[0.14em] text-steel">
            <span class="text-marker">{f.badge}</span> &middot; {f.note}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <!-- 05 METRIK OPERASIONAL: angka mono besar, label kecil -->
  <StatsStrip
    items={metrics}
    note="Angka hanya diambil dari bio Instagram resmi @fortisfit_jambi (diakses 16 Okt 2026) dan Linktree publik. Tidak ada klaim jumlah member, hasil dalam jangka waktu tertentu, atau testimoni."
  />

  <!-- 06 PANEL LOKASI BERWARNA + MapFacade -->
  <LocationPanel id="lokasi" />

  <!-- TRIAL FORM -->
  <section class="mx-auto max-w-content px-4 py-12 md:px-6 md:py-20" aria-labelledby="trial">
    <SectionHead index="03" label="Trial / konsultasi" title="Coba dulu, cocok baru lanjut" note="Balasan via WA" id="trial" />
    <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="max-w-[44ch] text-sm leading-relaxed text-steel">Isi form singkat, lanjut otomatis ke WhatsApp resmi. Tanpa komitmen, tanpa spam.</p>
        <ul class="mt-6">
          {['Slot trial dicek manual admin', 'Boleh tanya harga & jadwal dulu', 'Pemula dibantu mulai dari nol'].map((t) => (
            <li class="rule flex items-center gap-3 border-t border-steel/25 py-3 text-sm text-paper">
              <Icon name="check" size={16} class="shrink-0 text-marker" /> {t}
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-7">
        <TrialForm action={`https://wa.me/${business.phone}`} gymName={business.name} kind="wa" />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-content px-4 py-12 md:px-6 md:py-20" aria-labelledby="faq">
    <SectionHead index="04" label="FAQ" title="Masih ragu? Wajar." note="5 pertanyaan" id="faq" />
    <div class="mt-8"><Faq items={faqs} /></div>
  </section>

  <!-- 07 CTA WA + INSTAGRAM -->
  <CtaBand />
</BaseLayout>
