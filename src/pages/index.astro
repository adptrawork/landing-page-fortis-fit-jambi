---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, programs, waLink } from '../data/business';
const heroCta = waLink(`Halo ${business.name}, saya mau tanya free trial. Apakah slot masih ada?`);
---
<BaseLayout title={business.title} description={business.description} canonicalPath="/" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center min-h-[88dvh] py-10">
      <div class="md:col-span-7">
        <p class="flex items-center gap-2 text-sm font-medium text-rose-700">
          <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M128 16l36 74 82 12-59 58 14 82-73-38-73 38 14-82-59-58 82-12z"/></svg>
          <span class="font-mono-num">{business.followers}</span>
          <span class="text-zinc-500">• Gym + Kelas • Kota Jambi</span>
        </p>
        <h1 class="mt-4 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Fortis Fit Jambi — Gym + Kelas, Coba Dulu Baru Member</h1>
        <p class="mt-5 text-base text-gray-600 leading-relaxed max-w-[65ch]">Ada area beban & kardio, kelas grup, dan kamar mandi. {business.hours}. Price list ada di reel IG — konfirmasi trial via WA 0812-9933-3289.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={heroCta} class="bg-rose-700 text-white px-7 py-3.5 rounded-full font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]">Minta Free Trial</a>
          <a href="/harga" class="border border-zinc-300 px-7 py-3.5 rounded-full font-medium hover:border-zinc-950 active:scale-[0.98]">Lihat Harga</a>
        </div>
        <div class="mt-8 flex divide-x divide-zinc-200 border-t border-zinc-200 pt-5 text-sm">
          <div class="pr-6"><p class="font-mono-num font-semibold">07–22</p><p class="text-zinc-500">Weekday</p></div>
          <div class="px-6"><p class="font-mono-num font-semibold">07–18</p><p class="text-zinc-500">Weekend</p></div>
          <div class="pl-6"><p class="font-mono-num font-semibold">0812-9933-3289</p><p class="text-zinc-500">WA resmi (bio IG)</p></div>
        </div>
      </div>
      <div class="md:col-span-5">
        <div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
          <img src="/images/fortis-fit-1.jpg" alt="Rak dumbel area beban gym Fortis Fit Jambi" width="800" height="600" loading="eager" fetchpriority="high" class="w-full aspect-[4/3] object-cover" />
          <div class="p-8">
            <p class="font-semibold text-lg tracking-tight">Gym + kelas dalam satu tempat</p>
            <p class="mt-1 text-base text-gray-600">Latihan beban, ikut kelas, bilas di tempat. Weekend tutup 18.00 — datang lebih awal.</p>
          </div>
        </div>
        <p class="mt-3 text-xs text-zinc-400">Sumber: Unsplash (foto konteks area beban, bebas lisensi) — ganti foto asli gym.</p>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-7"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
        <img src="/images/fortis-fit-2.jpg" alt="Suasana kelas grup aerobik di gym Fortis Fit Jambi" width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
        <div class="p-8">
          <p class="font-semibold text-lg tracking-tight">Program: gym, kelas & personal training</p>
          <p class="text-base text-gray-600">Label Terverifikasi = sesuai bio IG resmi. <a class="underline" href="/program">Lihat semua program</a>.</p>
        </div>
      </div></div>
      <div class="md:col-span-5"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
        <img src="/images/fortis-fit-3.jpg" alt="Coach mendampingi member latihan beban di Fortis Fit Jambi" width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
        <div class="p-8">
          <p class="font-semibold text-lg tracking-tight">Didampingi coach</p>
          <p class="text-base text-gray-600">Pemula dibantu teknik dasar. <a class="underline" href="/pelatih">Kenalan dengan pelatih</a>.</p>
        </div>
      </div></div>
    </div>
    <p class="mt-3 text-xs text-zinc-400">Sumber: Unsplash (foto konteks kelas & coaching, bebas lisensi) — ganti foto asli gym.</p>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-10">
    <p class="text-sm font-medium text-rose-700">Harga</p>
    <h2 class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold">Mulai dari trial gratis</h2>
    <p class="mt-3 text-base text-gray-600 max-w-[65ch]">Price list resmi ada di reel IG @fortisfit_jambi. Angka di bawah estimasi — wajib konfirmasi via WA. <a class="underline text-zinc-900" href="/harga">Lihat semua harga</a></p>
    <div class="mt-6 grid grid-cols-1 md:grid-cols-12 gap-6">
      {programs.slice(3, 5).map((p) => (
        <div class="md:col-span-6"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden">
          <img src={p.img} alt={p.alt} width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
          <div class="p-6"><p class="text-xs font-medium text-rose-700">{p.badge}</p><p class="font-semibold">{p.name}</p></div>
        </div></div>
      ))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-5">
        <p class="text-sm font-medium text-rose-700">Lokasi</p>
        <h2 class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold">Cek rute sebelum datang</h2>
        <p class="mt-3 text-base text-gray-600 max-w-[65ch]">{business.address}. {business.hours}. <a class="underline text-zinc-900" href="/kontak">Hubungi & rute</a></p>
      </div>
      <div class="md:col-span-7">
        <div class="rounded-[2.5rem] overflow-hidden border border-slate-200/50 aspect-video bg-zinc-100">
          <iframe title="Peta Fortis Fit Jambi" src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
