---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, programs, waLink } from '../data/business';
---
<BaseLayout title={`Program ${business.name} — Gym, Kelas & Fasilitas`} description={`Program Fortis Fit Jambi: open gym beban & kardio, kelas grup, personal training, kamar mandi. Jam Senin–Jumat 07.00–22.00, weekend 07.00–18.00.`} canonicalPath="/program">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <p class="text-sm font-medium text-rose-700">Program</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Latihan apa saja di Fortis Fit?</h1>
    <p class="mt-3 text-base text-gray-600 max-w-[65ch]">Label <strong>Terverifikasi</strong> = sesuai bio IG resmi @fortisfit_jambi. Label <strong>Estimasi</strong> = belum terverifikasi, konfirmasi via WA.</p>
    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
      {programs.map((p, i) => (
        <article class={i % 2 === 1 ? 'md:mt-10' : ''}>
          <div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
            <img src={p.img} alt={p.alt} width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
            <div class="p-7">
              <p class="text-xs font-medium text-rose-700">{p.badge}</p>
              <h2 class="mt-1 font-semibold text-lg">{p.name}</h2>
              <p class="mt-1 text-base text-gray-600">{p.desc}</p>
              <a href={waLink(`Halo ${business.name}, saya mau tanya program ${p.name}. Bagaimana cara mulai?`)} class="mt-4 inline-block bg-zinc-950 text-white px-5 py-2.5 rounded-full text-sm">Tanya via WA</a>
            </div>
          </div>
        </article>
      ))}
    </div>
    <p class="mt-6 text-xs text-zinc-400">Sumber foto: Unsplash (foto konteks gym/kelas/coaching/sauna, bebas lisensi) — ganti foto asli gym.</p>
    <div class="mt-8 bg-white border border-slate-200/50 rounded-[2.5rem] p-8">
      <p class="font-semibold text-lg tracking-tight">Jam operasional (terverifikasi bio IG)</p>
      <div class="mt-3 overflow-x-auto"><table class="w-full text-sm">
        <thead><tr class="text-left text-zinc-500"><th class="py-2 pr-4">Hari</th><th class="py-2">Jam</th></tr></thead>
        <tbody>
          <tr class="border-t border-zinc-200"><td class="py-2 pr-4">Senin–Jumat</td><td class="py-2 font-mono-num">07.00–22.00</td></tr>
          <tr class="border-t border-zinc-200"><td class="py-2 pr-4">Sabtu–Minggu</td><td class="py-2 font-mono-num">07.00–18.00</td></tr>
        </tbody>
      </table></div>
      <p class="mt-3 text-sm text-gray-600">Jadwal kelas grup tidak dipublikasikan di bio — cek postingan/highlight IG atau <a class="underline" href={waLink('Halo Fortis Fit, minta jadwal kelas minggu ini.')}>tanya via WA</a>.</p>
    </div>
  </section>
</BaseLayout>
