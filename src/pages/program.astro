---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, programs, waLink } from '../data/business';
---
<BaseLayout title="Program Fortis Fit Jambi — Beban, Kelas & Personal Training" description="Program Fortis Fit Jambi: open gym beban & kardio, kelas grup aerobik & yoga, personal training, sauna & kamar mandi. Jadwal kelas via IG @fortisfit_jambi." canonicalPath="/program">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <p class="text-xs font-black uppercase tracking-[0.2em] text-orange-700">Program</p>
    <h1 class="mt-2 max-w-[18ch] text-4xl md:text-6xl tracking-tighter leading-none font-black uppercase">Beban keras, kelas seru</h1>
    <p class="mt-3 text-base text-stone-600 max-w-[65ch]">Label <strong>Terverifikasi</strong> = sesuai bio IG resmi. Jadwal kelas berubah — cek postingan IG.</p>
    <div class="mt-10 grid grid-cols-1 md:grid-cols-12 gap-6">
      {programs.map((p, i) => (
        <article class={i === 0 ? 'md:col-span-7' : i === 1 ? 'md:col-span-5' : i === 2 ? 'md:col-span-5' : i === 3 ? 'md:col-span-7' : 'md:col-span-12'}>
          <div class="bg-white border border-orange-700/20 rounded-[2.5rem] overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] h-full">
            <img src={p.img} alt={p.alt} width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
            <div class="p-7">
              <p class="font-mono-num text-xs font-bold text-orange-700">{p.badge}</p>
              <h2 class="mt-1 font-black uppercase tracking-tight text-lg">{p.name}</h2>
              <p class="mt-1 text-base text-stone-600">{p.desc}</p>
              <a href={waLink(`Halo ${business.name}, saya mau tanya program ${p.name}.`)} class="dir-fill mt-4 inline-block border border-stone-300 px-5 py-2.5 rounded-full text-sm font-bold uppercase tracking-wide active:scale-[0.98]">Tanya via WA</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
