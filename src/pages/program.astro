---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import ProgramRow from '../components/ProgramRow.astro';
import CtaBand from '../components/CtaBand.astro';
import { business, programs, waLink } from '../data/business';
const heroCta = waLink(`Halo ${business.name}, saya mau klaim free trial 1x.`);
const pageDescription =
  'Detail program Fortis Fit Jambi di Paal Lima: open gym area beban & kardio, kelas grup aerobik dan yoga, sauna, kamar mandi. Buka Sen–Jum 07–22, weekend 07–18.';
const metaFor = (badge: string) => [`Status~${badge}`, 'Konfirmasi~IG / WA admin'];
---
<!-- Ref: technical performance editorial — daftar program bernomor, border-t, meta mono -->
<BaseLayout title="Semua program & jadwal Fortis Fit Jambi — beban & kelas" description={pageDescription} canonicalPath="/program" image={business.ogImage} breadcrumb="Program">

  <section class="bg-ink" aria-labelledby="subhead">
    <div class="mx-auto max-w-content px-4 pb-10 pt-12 md:px-6 md:pb-14 md:pt-16">
      <nav class="num text-[11px] uppercase tracking-[0.16em] text-steel" aria-label="Breadcrumb">
        <a href="/" class="hover:text-marker">Beranda</a> <span class="text-steel/50">/</span> Program
      </nav>
      <h1 id="subhead" class="rise mt-4 max-w-[20ch] font-display text-[clamp(2.2rem,6.5vw,4.5rem)] font-bold uppercase leading-[0.92] tracking-[-0.03em]" style="--i:1">Semua program &amp; jadwal</h1>
      <p class="rise mt-4 max-w-[58ch] text-base leading-relaxed text-steel" style="--i:2">Lima entri program dengan label sumber data yang jelas. Jadwal kelas terbaru selalu mengikuti postingan Instagram resmi.</p>
      <a href={heroCta} class="rise mt-7 inline-flex min-h-[52px] items-center gap-2 bg-accent px-6 font-mono text-[12px] font-medium uppercase tracking-[0.16em] text-paper transition-colors hover:bg-accent-deep active:scale-[0.98]" style="--i:3">
        Klaim free trial
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-content px-4 py-12 md:px-6 md:py-16" aria-labelledby="daftar">
    <SectionHead index="01" label="Indeks program" title="Pilih sesuai tujuanmu" note="5 entri" id="daftar" />
    <div class="mt-10">
      {programs.map((p, i) => (
        <ProgramRow
          index={String(i + 1).padStart(2, '0')}
          name={p.name}
          desc={p.desc}
          badge={p.badge}
          img={p.img}
          alt={p.alt}
          meta={metaFor(p.badge)}
          href={heroCta}
          ctaLabel="Jadwalkan trial"
          flip={i % 2 === 1}
        />
      ))}
    </div>
    <p class="num mt-8 text-[11px] uppercase tracking-[0.14em] text-steel">
      Foto bersifat konteks &mdash; ganti dengan foto lokasi asli. <span class="text-marker">Terverifikasi</span> = klaim bio/reel IG resmi.
    </p>
  </section>

  <CtaBand
    title="Belum yakin mulai dari mana?"
    lead="Tanya dulu, gratis. Admin bantu pilihkan program sesuai level dan tujuanmu."
    message={`Halo ${business.name}, saya bingung pilih program. Bisa dibantu?`}
    waLabel="Tanya admin"
  />
</BaseLayout>
