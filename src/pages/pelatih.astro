---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, coaches, waLink } from '../data/business';
---
<BaseLayout title={`Pelatih ${business.name} — Coach & Personal Trainer`} description={`Tim pelatih Fortis Fit Jambi: coach gym, instruktur kelas, personal trainer. Daftar nama coach aktual cek IG @fortisfit_jambi.`} canonicalPath="/pelatih">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-7">
        <p class="text-sm font-medium text-rose-700">Pelatih</p>
        <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Dilatih coach, bukan coba-coba sendiri</h1>
        <p class="mt-3 text-base text-gray-600 max-w-[65ch]">Peran di bawah <strong>Estimasi</strong> — nama & jadwal coach aktual berubah-ubah, cek highlight/postingan IG @fortisfit_jambi atau tanya via WA.</p>
      </div>
      <div class="md:col-span-5">
        <div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden">
          <img src="/images/fortis-fit-3.jpg" alt="Coach mendampingi member latihan beban di Fortis Fit Jambi" width="800" height="600" loading="eager" class="w-full aspect-[4/3] object-cover" />
          <p class="p-5 text-sm text-gray-600">Sesi coaching 1-on-1 — foto konteks, ganti foto asli. Sumber: Unsplash (bebas lisensi).</p>
        </div>
      </div>
    </div>
    <div class="mt-10 grid grid-cols-1 md:grid-cols-12 gap-6">
      {coaches.map((c) => (
        <div class="md:col-span-4"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 h-full">
          <svg width="28" height="28" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="1.5" class="text-rose-700" aria-hidden="true"><circle cx="128" cy="80" r="40"/><path d="M48 224c0-44 36-72 80-72s80 28 80 72"/></svg>
          <p class="mt-4 text-xs font-medium text-rose-700">{c.badge}</p>
          <p class="mt-1 font-semibold text-lg tracking-tight">{c.role}</p>
          <p class="mt-1 text-base text-gray-600">{c.desc}</p>
        </div></div>
      ))}
    </div>
    <a href={waLink(`Halo ${business.name}, saya pemula. Bisa dibantu coach saat pertama datang?`)} class="mt-8 inline-block bg-rose-700 text-white px-8 py-3.5 rounded-full font-medium">Minta Didampingi Coach</a>
  </section>
</BaseLayout>
