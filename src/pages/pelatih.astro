---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, coaches, waLink } from '../data/business';
---
<BaseLayout title="Pelatih Fortis Fit Jambi — Coach Gym & Instruktur Kelas" description="Pelatih Fortis Fit Jambi: coach gym & beban, instruktur kelas grup, personal trainer. Daftar coach aktual di IG @fortisfit_jambi." canonicalPath="/pelatih">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-7">
        <p class="text-xs font-black uppercase tracking-[0.2em] text-orange-700">Pelatih</p>
        <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-black uppercase">Dilatih yang paling berisik</h1>
        <p class="mt-3 text-base text-stone-600 max-w-[65ch]">Peran di bawah <strong>Estimasi</strong> — daftar coach aktual cek IG.</p>
      </div>
      <div class="md:col-span-5">
        <div class="bg-white border border-orange-700/20 rounded-[2.5rem] overflow-hidden">
          <img src="/images/fortis-fit-3.jpg" alt="Coach mendampingi member latihan beban di Fortis Fit Jambi" width="800" height="600" loading="eager" class="w-full aspect-[4/3] object-cover" />
          <p class="p-5 text-sm text-stone-600">Sesi coaching — foto konteks (Unsplash). Ganti foto asli.</p>
        </div>
      </div>
    </div>
    <ol class="mt-10 space-y-4">
      {coaches.map((c, i) => (
        <li class={`rounded-[2.5rem] p-8 flex flex-col md:flex-row md:items-center gap-4 ${i === 0 ? 'bg-stone-900 text-orange-50' : 'bg-white border border-orange-700/20'}`}>
          <span class={`font-mono-num font-bold text-3xl ${i === 0 ? 'text-orange-400' : 'text-orange-700'}`}>0{i + 1}</span>
          <div class="flex-1">
            <p class={`font-mono-num text-xs font-bold ${i === 0 ? 'text-orange-300' : 'text-orange-700'}`}>{c.badge}</p>
            <p class="mt-1 font-black uppercase tracking-tight text-lg">{c.role}</p>
            <p class={`mt-1 text-base ${i === 0 ? 'text-orange-100/70' : 'text-stone-600'}`}>{c.desc}</p>
          </div>
          <a href={waLink(`Halo ${business.name}, saya mau dilatih (${c.role}).`)} class={`dir-fill shrink-0 text-center px-6 py-3 rounded-full text-sm font-bold uppercase tracking-wide border ${i === 0 ? 'border-orange-300/60' : 'border-stone-300'} active:scale-[0.98]`}>Tanya via WA</a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
